<?xml version="1.0" encoding="utf-8"?>
<!-- Rust WebRCON is plain ws:// (no TLS), so cleartext traffic to the server the user typed in must be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
